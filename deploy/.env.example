# Values for the Coolify "Environment Variables" tab (docker-compose.yaml reads every one of these).
# Never commit real values; deploy/.env is gitignored.

# Images pushed by .github/workflows/deploy.yml (lowercase owner/repo)
BACKEND_IMAGE=ghcr.io/OWNER/REPO/backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/frontend:latest
MESSAGING_IMAGE=ghcr.io/OWNER/REPO/messaging:latest
TODO_API_IMAGE=ghcr.io/OWNER/REPO/todo-api:latest
TODO_WORKER_IMAGE=ghcr.io/OWNER/REPO/todo-worker:latest

# Browser-facing origin, exactly as the Coolify domain on the frontend service (no trailing slash)
PUBLIC_URL=https://todo.example.com

# Secrets: use long random values
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=app
RABBITMQ_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Base64 PKCS#8 RSA key, single line:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | grep -v '^-----' | tr -d '\n'
JWT_PRIVATE_KEY=
